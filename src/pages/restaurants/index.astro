---
import { allRestaurants } from '@/data/segments/restaurants';
import MainLayout from '@/layouts/MainLayout.astro';
import { MapPin, Clock, ChevronRight } from 'lucide-astro';

// 🔑 Filtramos solo los válidos para que NO rompa
const restaurantesValidos = allRestaurants.filter(r => r && r.slug);
console.log(restaurantesValidos)
---

<MainLayout>
  <section class="restaurants-page">
    <div class="container">
      <!-- Encabezado -->
      <div class="restaurants-header" data-aos="fade-down">
        <h1 class="restaurants-title">Nossos Parceiros</h1>
        <p class="restaurants-subtitle">Escolha e conheça nosso restaurante</p>
      </div>

      <!-- ⚠️ Si no hay ninguno -->
      {restaurantesValidos.length === 0 && (
        <p style="text-align:center; color:red; padding:2rem;">
          ⚠️ Nenhum restaurante carregado — verifique o arquivo de dados
        </p>
      )}

      <!-- Tarjetas de restaurantes -->
      <div class="restaurants-grid">
        {restaurantesValidos.map((restaurant, index) => (
          <a 
            href={`/restaurants/${restaurant.slug}/splash`}
            class="restaurant-card"
            key={restaurant.slug}
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <!-- Logo -->
            <div class="restaurant-card__logo-wrap">
              <img 
                src={restaurant.logo} 
                alt={restaurant.name}
                class="restaurant-card__logo"
                loading="lazy"
              />
            </div>
            <!-- Información -->
            <div class="restaurant-card__info">
              <h2 class="restaurant-card__name">{restaurant.name}</h2>
              <p class="restaurant-card__tag">{restaurant.tagline}</p>
              
              <div class="restaurant-card__meta">
                <span class="restaurant-card__status">
                  <span class="status-dot"></span>
                  {restaurant.isOpen ? 'Aberto Agora' : 'Fechado'}
                </span>
                <span class="restaurant-card__hours">
                  <Clock size={12} />
                  {restaurant.todayHours}
                </span>
              </div>
            </div>
            <!-- Flecha -->
            <div class="restaurant-card__arrow">
              <ChevronRight size={20} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
/* =============================================
   PÁGINA: Lista de Restaurantes
   ============================================= */
.restaurants-page {
  padding: 3rem 0 5rem;
  min-height: 80vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
}
.restaurants-header {
  text-align: center;
  margin-bottom: 3rem;
}
.restaurants-title {
  font-size: 2rem;
  font-weight: 900;
  color: #0f172a;
  margin: 0 0 0.5rem;
}
.restaurants-subtitle {
  font-size: 1rem;
  color: #64748b;
  margin: 0;
}
/* Grilla */
.restaurants-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}
@media (min-width: 640px) {
  .restaurants-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .restaurants-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
}
/* Tarjeta */
.restaurant-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: white;
  border-radius: 1rem;
  padding: 1.25rem;
  text-decoration: none;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
  border: 1px solid #e2e8f0;
  transition: all 0.3s ease;
}
.restaurant-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.1);
  border-color: #cbd5e1;
}
.restaurant-card__logo-wrap {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid #f1f5f9;
  background: #f8fafc;
}
.restaurant-card__logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.restaurant-card__info {
  flex: 1;
  min-width: 0;
}
.restaurant-card__name {
  font-size: 1.1rem;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 0.15rem;
}
.restaurant-card__tag {
  font-size: 0.8rem;
  color: #64748b;
  margin: 0 0 0.5rem;
}
.restaurant-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
  align-items: center;
}
.restaurant-card__status {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: #16a34a;
}
.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #16a34a;
  animation: pulse 2s infinite;
}
.restaurant-card__status:has(.status-dot:only-child) {
  color: #ef4444;
}
.restaurant-card__status:has(.status-dot:only-child) .status-dot {
  background: #ef4444;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.restaurant-card__hours {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: #64748b;
}
.restaurant-card__arrow {
  flex-shrink: 0;
  color: #cbd5e1;
  transition: transform 0.2s ease;
}
.restaurant-card:hover .restaurant-card__arrow {
  transform: translateX(3px);
  color: #94a3b8;
}
</style>