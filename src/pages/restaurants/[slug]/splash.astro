---
import { allRestaurants } from '../../../data/segments/restaurants';
import { getThemePath } from '../../../assets/styles/index';
import type { SplashData } from '@/types';

import SplashGeometric from '../../../components/splash/SplashGeometric.astro';
import SplashMinimal from '../../../components/splash/SplashMinimal.astro';
import SplashNeon from '../../../components/splash/SplashNeon.astro';

export async function getStaticPaths() {
  const validos = allRestaurants.filter(r => r && r.slug);
  return validos.map((restaurant) => ({ params: { slug: restaurant.slug } }));
}

const { slug } = Astro.params;
const restaurant = allRestaurants.find(r => r && r.slug === slug);
if (!restaurant) return Astro.redirect('/404');

const style = restaurant.splashStyle || 'geometric';
const themePath = getThemePath(slug);
const destino = `/restaurants/${slug}`;

// Adaptador: acá vive el conocimiento de "esto es un Restaurant",
// los componentes de splash reciben la forma genérica nomás.
const splashData: SplashData = {
  slug: restaurant.slug,
  name: restaurant.name,
  tagline: restaurant.tagline,
  logo: restaurant.logo,
  splash: restaurant.splash,
  previewImages: restaurant.heroSlider?.map((h) => h.image),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{restaurant.name} - Carregando...</title>
    {themePath && <link rel="stylesheet" href={themePath} />}
  </head>
  <body>
    {style === 'geometric' && <SplashGeometric data={splashData} />}
    {style === 'minimal' && <SplashMinimal data={splashData} />}
    {style === 'neon' && <SplashNeon data={splashData} />}

    <script define:vars={{ destino }}>
      setTimeout(() => { window.location.href = destino; }, 5000);
    </script>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { min-height: 100vh; font-family: system-ui, sans-serif; overflow: hidden; }
    </style>
  </body>
</html>