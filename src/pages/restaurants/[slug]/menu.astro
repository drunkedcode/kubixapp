---
import RestaurantLayout from '../../../layouts/RestaurantLayout.astro';
import { allRestaurants } from '../../../data/segments/restaurants';
import CartDock from '@/components/shared/CartDock.astro';
import MenuLightbox from '@/components/restaurants/menus/MenuLightbox.astro';
import CombosGrid from '../../../components/restaurants/menus/combos/grids/CombosGrid.astro';
import CombosPremiumSlider from '../../../components/restaurants/menus/combos/premiuns/CombosPremiumSlider.astro';
import List from '../../../components/restaurants/menus/list/List.astro';
import DailyMenu from '../../../components/restaurants/menus/daily/DailyMenu.astro';

export async function getStaticPaths() {
  return allRestaurants
    .filter((r) => r && r.slug)
    .map((restaurant) => ({
      params: { slug: restaurant.slug }
    }));
}

const { slug } = Astro.params;
const restaurant = allRestaurants.find((r) => r && r.slug === slug);
if (!restaurant) return Astro.redirect('/restaurants');

const menuData = restaurant.menuData;
const companyKey = `restaurants/${restaurant.slug}`;

// Datos de cada sección
const premium = menuData?.combosPremium;
const menuDelDia = menuData?.menuDelDia;
const simples = menuData?.combosSimples;
const lists = menuData?.lists;
const drinks = menuData?.drinks;

// Verificaciones para renderizado condicional
const hasPremium = Boolean(premium?.items?.length);
const hasMenuDelDia = Boolean(menuDelDia?.days?.length);
const hasSimples = Boolean(simples?.items?.length);
const hasLists = Boolean(lists?.categories?.length);
const hasDrinks = Boolean(drinks?.categories?.length);

// Previsualización de combos simples
const previewCount = simples?.previewCount ?? 6;
const simplesPreview = simples?.items?.slice(0, previewCount) ?? [];
const hasMore = (simples?.items?.length ?? 0) > previewCount;

// Si hay al menos una sección activa
const hasAnything = hasPremium || hasMenuDelDia || hasSimples || hasLists || hasDrinks;
---

<RestaurantLayout restaurant={restaurant}>
  <div class="menu-page" data-aos="fade-up">
    {hasPremium && <CombosPremiumSlider data={premium} />}
    
    {hasMenuDelDia && <DailyMenu data={menuDelDia} />}
    
    {hasSimples && (
      <CombosGrid
        title={simples.title ?? 'Combos'}
        note={simples.note}
        items={simplesPreview}
        allItems={simples.items}
        moreHref={hasMore ? `/restaurants/${slug}/combos` : undefined}
      />
    )}
    
    {hasLists && <List data={lists} />}
    {hasDrinks && <List data={drinks} />}
    
    {!hasAnything && (
      <div class="empty-state">
        <h2>🚧 Menu em preparação</h2>
        <p>Nenhum item cadastrado no momento.</p>
        <a href={`/restaurants/${slug}`} class="back-link">← Voltar para página inicial</a>
      </div>
    )}
  </div>

  <MenuLightbox companyKey={companyKey} />
  <CartDock 
    companyKey={companyKey} 
    phone={restaurant.whatsapp ?? restaurant.phone} 
    name={restaurant.name} 
  />
</RestaurantLayout>

<style>
.menu-page {
  padding: 0.5rem 0 5.5rem;
}

.empty-state {
  margin: 1rem;
  padding: 2rem 1.25rem;
  text-align: center;
  background: var(--bg-card);
  border: 2px dashed var(--border-light);
  border-radius: 1rem;
}

.empty-state h2 {
  margin-bottom: 0.4rem;
  font-size: 1.2rem;
  color: var(--text-dark);
}

.empty-state p {
  margin-bottom: 0.75rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.back-link {
  display: inline-block;
  font-weight: 700;
  color: var(--brand-primary);
}

.back-link:hover {
  text-decoration: underline;
}
</style>