---
import MainLayout from '@/layouts/MainLayout.astro';
import { Building2, Search } from 'lucide-astro';
import { useTranslations } from '../i18n';
import { allRestaurants } from '../data/segments/restaurants';

const t = useTranslations(Astro.cookies, Astro.url);

const restaurantsMap = allRestaurants.map((r) => ({
  key: `restaurants/${r.slug}`,
  name: r.name,
  logo: r.logo,
  href: `/restaurants/${r.slug}/splash`,
}));
---

<MainLayout hasBottomNav={false}>
  <div
    class="home-landing container"
    data-restaurants={JSON.stringify(restaurantsMap)}
  >
    <!-- Cabecera y buscador -->
    <section class="landing-header">
      <h1 class="landing-title">
        Suas <span>Empresas</span>
      </h1>

      <div class="search-box">
        <Search size={16} class="search-icon" aria-hidden="true" />
        <input
          id="followed-filter"
          type="text"
          placeholder="Filtrar empresas..."
          autocomplete="off"
          aria-label="Filtrar empresas"
        />
      </div>
    </section>

    <!-- Grid de empresas -->
    <section class="landing-grid-section">
      <div id="followed-grid" class="mini-grid">
        <!-- Las tarjetas se cargarán aquí dinámicamente -->
      </div>

      <div id="followed-empty" class="empty-state" hidden>
        <Building2 size={36} class="empty-icon" aria-hidden="true" />
        <p>Nenhuma empresa encontrada.</p>
        <span>Você ainda não segue nenhuma empresa ou o termo buscado não existe.</span>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  interface RestaurantItem {
    key: string;
    name: string;
    logo: string;
    href: string;
  }

  const containerEl = document.querySelector(
    '.home-landing',
  ) as HTMLElement | null;

  const gridEl = document.getElementById('followed-grid');
  const emptyEl = document.getElementById('followed-empty');
  const filterInput = document.getElementById(
    'followed-filter',
  ) as HTMLInputElement | null;

  const allRestaurantsData: RestaurantItem[] = JSON.parse(
    containerEl?.dataset.restaurants || '[]',
  );

  function getFollowedKeys(): string[] {
    try {
      const stored =
        localStorage.getItem('kubix:following') ??
        localStorage.getItem('following') ??
        localStorage.getItem('visited');

      const parsed = stored ? JSON.parse(stored) : [];

      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function createCardElement(
    href: string,
    name: string,
    logoHtml: string,
    index: number,
    isGeneral = false
  ): HTMLAnchorElement {
    const card = document.createElement('a');
    card.href = href;
    card.className = `mini-card ${isGeneral ? 'fixed-general-card' : ''}`;
    card.dataset.name = name.toLowerCase();
    
    // Retraso escalonado más sutil y elegante
    card.style.animationDelay = `${index * 0.04}s`;

    card.innerHTML = `
      <div class="mini-card__logo-wrap ${isGeneral ? 'mini-card__logo-wrap--general' : ''}">
        ${logoHtml}
      </div>
      <div class="mini-card__footer">
        <span class="mini-card__name">${name}</span>
      </div>
    `;

    return card;
  }

  function applyFilter(): void {
    if (!gridEl || !filterInput) return;

    const term = filterInput.value.toLowerCase().trim();
    const cards = gridEl.querySelectorAll<HTMLAnchorElement>('.mini-card');

    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const matches = !term || name.includes(term);

      if (matches) {
        card.classList.remove('is-hidden');
        visibleCount++;
      } else {
        card.classList.add('is-hidden');
      }
    });

    if (emptyEl) {
      emptyEl.hidden = visibleCount > 0;
    }
  }

  function loadFollowedCompanies(): void {
    if (!gridEl) return;

    gridEl.innerHTML = '';
    let cardIndex = 0;

    // 1. Tarjeta General
    const generalLogoHtml = `<span style="font-size: 1.8rem; font-weight: 800; color: #d62027;">▦</span>`;
    const generalCard = createCardElement('/general', 'General', generalLogoHtml, cardIndex++, true);
    gridEl.appendChild(generalCard);

    // 2. Tarjetas de empresas seguidas
    const followedKeys = getFollowedKeys();

    const followedList = followedKeys
      .map((key) => allRestaurantsData.find((restaurant) => restaurant.key === key))
      .filter((item): item is RestaurantItem => Boolean(item));

    const uniqueRestaurants = [
      ...new Map(followedList.map((item) => [item.key, item])).values(),
    ];

    uniqueRestaurants.forEach((item) => {
      const logoHtml = `<img src="${item.logo}" alt="Logo de ${item.name}" loading="lazy" />`;
      const restaurantCard = createCardElement(item.href, item.name, logoHtml, cardIndex++, false);
      gridEl.appendChild(restaurantCard);
    });

    applyFilter();
  }

  filterInput?.addEventListener('input', applyFilter);

  loadFollowedCompanies();
</script>

<style is:global>
  /* Animación de entrada sutil, fluida y profesional */
  @keyframes cardAppear {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .home-landing {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .landing-header {
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .landing-title {
    margin: 0 0 1rem;
    color: #111;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .landing-title span {
    color: #d62027;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .search-box:focus-within {
    border-color: #d62027;
    box-shadow: 0 0 0 3px rgba(214, 32, 39, 0.08);
  }

  .search-icon {
    flex-shrink: 0;
    color: #94a3b8;
  }

  .search-box input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: #1e293b;
    font: inherit;
    font-size: 0.9rem;
  }

  .landing-grid-section {
    margin-top: 1.5rem;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  /* Estilos y transiciones sutiles en las tarjetas */
  .mini-card {
    display: flex !important;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 1rem !important;
    overflow: hidden !important;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03) !important;
    
    /* Animación de entrada suave y pausada */
    animation: cardAppear 0.5s cubic-bezier(0.25, 1, 0.5, 1) both;
    
    /* Transiciones fluidas y elegantes al interactuar */
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), 
                border-color 0.25s ease, 
                box-shadow 0.25s ease, 
                opacity 0.25s ease;
  }

  .mini-card:hover {
    transform: translateY(-2px); /* Sutil elevación */
    border-color: #d62027 !important;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08) !important;
  }

  .mini-card:active {
    transform: scale(0.98);
  }

  .mini-card.is-hidden {
    display: none !important;
  }

  .mini-card__logo-wrap {
    display: flex !important;
    width: 100% !important;
    aspect-ratio: 1/1 !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 1rem !important;
    background: #f8fafc !important;
    border-bottom: 1px solid #e2e8f0 !important;
  }

  .mini-card__logo-wrap img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 50% !important;
    object-fit: cover !important;
    background: #ffffff !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  .mini-card__logo-wrap--general {
    background: linear-gradient(135deg, rgba(214, 32, 39, 0.05) 0%, rgba(214, 32, 39, 0.1) 100%) !important;
  }

  .mini-card__footer {
    width: 100% !important;
    min-width: 0 !important;
    padding: 0.75rem 0.5rem !important;
    background: #ffffff !important;
    text-align: center !important;
  }

  .mini-card__name {
    display: block !important;
    width: 100% !important;
    overflow: hidden !important;
    color: #1e293b !important;
    font-size: 0.75rem !important;
    font-weight: 800 !important;
    line-height: 1.3 !important;
    white-space: nowrap !important;
    text-overflow: ellipsis !important;
  }

  .empty-state {
    margin-top: 1.5rem;
    padding: 3rem 1.5rem;
    border: 2px dashed #cbd5e1;
    border-radius: 1rem;
    background: #ffffff;
    text-align: center;
    animation: cardAppear 0.4s ease-out;
  }

  .empty-icon {
    margin-bottom: 0.75rem;
    color: #94a3b8;
  }

  .empty-state p {
    margin: 0 0 0.3rem;
    color: #1e293b;
    font-size: 1rem;
    font-weight: 800;
  }

  .empty-state span {
    color: #64748b;
    font-size: 0.825rem;
  }

  @media (max-width: 480px) {
    .mini-grid {
      gap: 0.75rem;
    }
    .mini-card__name {
      font-size: 0.7rem !important;
    }
  }
</style>