---
import BaseLayout from './BaseLayout.astro';
import KubixNavbar from './components/KubixNavbar.astro';
import BottomNav from './components/BottomNav.astro';
import { siteData } from '../data/siteData';
import { Home, Camera, User } from 'lucide-astro';

interface Props {
  hasBottomNav?: boolean;
}

const { hasBottomNav = true } = Astro.props;
const { company } = siteData;

const navItems = [
  { href: '/', label: 'Home', icon: Home },
  { href: '/scan', label: 'Cámara', ariaLabel: 'Escanear QR', icon: Camera, highlight: true },
  { href: '/profile', label: 'Perfil', icon: User },
];
---

<BaseLayout
  title={`${company.name} — ${company.subtitle}`}
  description={company.description}
  hasBottomNav={hasBottomNav}
>
  <KubixNavbar slot="header" name={company.name} logo="/favicon.ico" />

  <slot />

  {hasBottomNav && <BottomNav slot="footer" items={navItems} />}
</BaseLayout>