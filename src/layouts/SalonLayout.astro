---
import type { Salon } from '../data/segments/salons';
import BaseLayout from './BaseLayout.astro';
import SalonNavbar from '../components/salons/SalonNavbar.astro';

interface Props {
  salon: Salon;
}

const { salon } = Astro.props;
---

<BaseLayout
  title={`${salon.name} — Espaço para Eventos`}
  description={salon.description}
>
  <style slot="head" is:global>
    :root {
      --brand-primary: #4A154B;
      --brand-primary-dark: #37103A;
      --brand-primary-text: #FFFFFF;
      --brand-secondary: #F0C808;
      --brand-secondary-dark: #C9A700;
      --brand-secondary-text: #1A1A1A;
      --bg-page: #F8F5FC;
    }
  </style>

  <SalonNavbar slot="header" salon={salon} />

  <slot />
</BaseLayout>