---
interface Item {
  href: string;
  label: string;
  ariaLabel?: string;
  icon: any;              // componente de lucide-astro
  highlight?: boolean;    // botón destacado (cámara)
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<nav class="bnav" aria-label="Navegación principal">
  {items.map((item) => {
    const Icon = item.icon;
    return (
      <a
        href={item.href}
        class:list={['bnav__item', { 'bnav__item--highlight': item.highlight, 'is-active': isActive(item.href) }]}
        aria-label={item.ariaLabel ?? item.label}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.highlight ? (
          <span class="bnav__fab"><Icon size={28} aria-hidden="true" /></span>
        ) : (
          <Icon class="bnav__icon" size={24} aria-hidden="true" />
        )}
        <span class="bnav__label">{item.label}</span>
      </a>
    );
  })}
</nav>

<style>
/*
  Variables que debe proveer el layout/tema (este componente no define colores):
  --bnav-bg, --bnav-border, --bnav-text, --bnav-text-active,
  --bnav-fab-bg, --bnav-fab-text, --bnav-fab-ring, --bnav-fab-shadow
*/
.bnav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: var(--app-max-width);
  z-index: 9999;
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: calc(4.25rem + env(safe-area-inset-bottom, 0px));
  padding: 0 1rem env(safe-area-inset-bottom, 0px);
  background: var(--bnav-bg);
  border-top: 1px solid var(--bnav-border);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.25);
}

.bnav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.2rem;
  text-decoration: none;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--bnav-text);
  transition: color 0.2s ease;
}

.bnav__item:hover,
.bnav__item:focus-visible,
.bnav__item.is-active {
  color: var(--bnav-text-active);
}

.bnav__icon {
  transition: transform 0.2s ease;
}

.bnav__item:active .bnav__icon {
  transform: scale(0.9);
}

/* Botón destacado */
.bnav__item--highlight {
  position: relative;
  top: -0.75rem;
}

.bnav__fab {
  width: 3.5rem;
  height: 3.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bnav-fab-bg);
  color: var(--bnav-fab-text);
  border: 4px solid var(--bnav-fab-ring);
  box-shadow: var(--bnav-fab-shadow);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bnav__item--highlight:hover .bnav__fab { transform: scale(1.08); }
.bnav__item--highlight:active .bnav__fab { transform: scale(0.95); }
</style>