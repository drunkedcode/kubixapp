---
import { Clock, ChevronDown, X } from 'lucide-astro';

interface Props {
  name: string;
  tagline: string;
  logo: string;
  isOpen: boolean;
  todayHours: string;
  schedule: Array<{
    day: string;
    hours: string;
    current: boolean;
  }>;
  homeUrl?: string;
}

const {
  name,
  tagline,
  logo,
  isOpen,
  todayHours,
  schedule,
  homeUrl = "/"
} = Astro.props;
---

<header class="navbar">
  <div class="navbar__inner">

    <!-- Marca -->
    <a href={homeUrl} class="navbar__brand" aria-label={`Página inicial de ${name}`}>
      <img
        src={logo}
        alt={name}
        class="navbar__logo"
        width="44"
        height="44"
        loading="eager"
      />
      <div class="navbar__info">
        <h1 class="navbar__name">{name}</h1>
        <p class="navbar__tag">{tagline}</p>
      </div>
    </a>

    <!-- Horarios -->
    <div class="navbar__schedule-wrapper">
      <button
        id="schedule-toggle"
        class="navbar__schedule-btn"
        aria-expanded="false"
        aria-controls="schedule-dropdown"
      >
        <span class={`status-badge ${isOpen ? 'status-badge--open' : 'status-badge--closed'}`}>
          <span class="status-badge__dot"></span>
          {isOpen ? 'Aberto' : 'Fechado'}
        </span>
        <span class="navbar__hours-preview">
          <Clock size={12} aria-hidden="true" />
          <span>{todayHours}</span>
          <ChevronDown size={14} class="navbar__chevron" aria-hidden="true" />
        </span>
      </button>

      <!-- Dropdown Horarios -->
      <div id="schedule-dropdown" class="schedule-dropdown" hidden>
        <div class="schedule-dropdown__header">
          <h3>Horário de Funcionamento</h3>
          <button id="schedule-close" class="schedule-dropdown__close" aria-label="Fechar">
            <X size={16} aria-hidden="true" />
          </button>
        </div>
        <ul class="schedule-dropdown__list">
          {schedule.map((item) => (
            <li class={`schedule-dropdown__item ${item.current ? 'is-today' : ''}`}>
              <span class="schedule-dropdown__day">
                {item.day}
                {item.current && <span class="today-tag">Hoje</span>}
              </span>
              <span class="schedule-dropdown__hours">{item.hours}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</header>

<script>
  const toggleBtn = document.getElementById('schedule-toggle');
  const closeBtn = document.getElementById('schedule-close');
  const dropdown = document.getElementById('schedule-dropdown');

  function openDropdown() {
    dropdown?.removeAttribute('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    toggleBtn?.classList.add('active');
  }

  function closeDropdown() {
    dropdown?.setAttribute('hidden', '');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.classList.remove('active');
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    isExpanded ? closeDropdown() : openDropdown();
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeDropdown();
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target as Node) && !toggleBtn?.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });
</script>

<style>
/*
  Colores: este componente NO define ninguno.
  El padre/tema debe proveer estas variables:

  --navbar-bg
  --navbar-border
  --navbar-text            texto principal (nombre, horas)
  --navbar-accent          tagline
  --navbar-logo-bg
  --navbar-logo-border

  --navbar-btn-bg
  --navbar-btn-bg-hover
  --navbar-btn-border

  --navbar-open-bg / --navbar-open-text
  --navbar-closed-bg / --navbar-closed-text

  --navbar-dropdown-bg
  --navbar-dropdown-border
  --navbar-dropdown-text
  --navbar-dropdown-muted
  --navbar-today-bg
  --navbar-today-accent    borde izquierdo y etiqueta "Hoje"
  --navbar-today-accent-text
*/

/* Solo espaciado/estructura (no colores) */
.navbar {
  --nb-space-1: 0.25rem;
  --nb-space-2: 0.5rem;
  --nb-space-3: 0.75rem;
  --nb-space-4: 1rem;

  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--navbar-bg);
  border-bottom: 2px solid var(--navbar-border);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  padding: var(--nb-space-3) var(--nb-space-4);
}

.navbar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--nb-space-4);
  max-width: 1100px;
  margin: 0 auto;
}

ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* Marca */
.navbar__brand {
  display: flex;
  align-items: center;
  gap: var(--nb-space-3);
  flex: 1;
  min-width: 0;
  text-decoration: none;
}

.navbar__logo {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 50%;
  object-fit: cover;
  background-color: var(--navbar-logo-bg);
  border: 2px solid var(--navbar-logo-border);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}

.navbar__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.navbar__name {
  margin: 0;
  font-size: 1rem;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--navbar-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.navbar__tag {
  margin: 0;
  font-size: 0.65rem;
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: var(--navbar-accent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Horarios */
.navbar__schedule-wrapper {
  position: relative;
  flex-shrink: 0;
}

.navbar__schedule-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--nb-space-1);
  padding: var(--nb-space-2) var(--nb-space-3);
  background: var(--navbar-btn-bg);
  border: 1px solid var(--navbar-btn-border);
  border-radius: 0.75rem;
  cursor: pointer;
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.navbar__schedule-btn:hover,
.navbar__schedule-btn.active {
  background: var(--navbar-btn-bg-hover);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 0.625rem;
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.status-badge--open {
  background-color: var(--navbar-open-bg);
  color: var(--navbar-open-text);
}

.status-badge--closed {
  background-color: var(--navbar-closed-bg);
  color: var(--navbar-closed-text);
}

.status-badge__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: currentColor;
}

.navbar__hours-preview {
  display: flex;
  align-items: center;
  gap: var(--nb-space-1);
  padding: 0 2px;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--navbar-text);
  white-space: nowrap;
}

.navbar__chevron {
  transition: transform 0.2s ease;
}

.navbar__schedule-btn.active .navbar__chevron {
  transform: rotate(180deg);
}

/* Dropdown */
.schedule-dropdown {
  position: absolute;
  top: calc(100% + var(--nb-space-2));
  right: 0;
  width: min(16rem, calc(100vw - 2rem));
  padding: var(--nb-space-4);
  background: var(--navbar-dropdown-bg);
  border: 1px solid var(--navbar-dropdown-border);
  border-radius: 0.875rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  z-index: 110;
  animation: fadeInDown 0.2s ease-out forwards;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.schedule-dropdown__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--nb-space-3);
  padding-bottom: var(--nb-space-3);
  margin-bottom: var(--nb-space-3);
  border-bottom: 1px solid var(--navbar-dropdown-border);
}

.schedule-dropdown__header h3 {
  margin: 0;
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--navbar-dropdown-text);
}

.schedule-dropdown__close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--nb-space-1);
  background: none;
  border: none;
  border-radius: 6px;
  color: var(--navbar-dropdown-muted);
  cursor: pointer;
}

.schedule-dropdown__close:hover {
  color: var(--navbar-dropdown-text);
  background: var(--navbar-today-bg);
}

.schedule-dropdown__list {
  display: flex;
  flex-direction: column;
  gap: var(--nb-space-1);
}

.schedule-dropdown__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--nb-space-3);
  padding: var(--nb-space-2) var(--nb-space-3);
  border-radius: 0.5rem;
  border-left: 3px solid transparent;
  font-size: 0.75rem;
  color: var(--navbar-dropdown-text);
}

.schedule-dropdown__item.is-today {
  background-color: var(--navbar-today-bg);
  border-left-color: var(--navbar-today-accent);
  font-weight: 700;
}

.schedule-dropdown__day {
  display: inline-flex;
  align-items: center;
  gap: var(--nb-space-2);
}

.today-tag {
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 0.6rem;
  font-weight: 800;
  background: var(--navbar-today-accent);
  color: var(--navbar-today-accent-text);
}

.schedule-dropdown__hours {
  font-size: 0.725rem;
  white-space: nowrap;
  color: var(--navbar-dropdown-muted);
}

.schedule-dropdown__item.is-today .schedule-dropdown__hours {
  color: var(--navbar-dropdown-text);
}
</style>