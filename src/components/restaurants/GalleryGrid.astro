---
interface GalleryItem {
  id: number | string;
  image?: string; // Para compatibilidad con la estructura actual
  url?: string;   // O si viene como url
  video?: string; // O si viene directo como video
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items = [] } = Astro.props;

// Función auxiliar para determinar si el elemento es un video o imagen basándonos en los datos reales
const getMediaInfo = (item: GalleryItem) => {
  const mediaUrl = item.video || item.url || item.image || '';
  const isVideo = Boolean(item.video || mediaUrl.match(/\.(mp4|webm|mov)$/i));
  return { mediaUrl, isVideo };
};
---

<div class="gallery-grid">
  {items.map((item, index) => {
    const { mediaUrl, isVideo } = getMediaInfo(item);
    return (
      <div 
        class="gallery-item" 
        data-full={mediaUrl} 
        data-type={isVideo ? 'video' : 'image'}
      >
        {isVideo ? (
          <div class="video-wrapper">
            <video src={mediaUrl} muted playsinline></video>
            <div class="play-badge">▶</div>
          </div>
        ) : (
          <img 
            src={mediaUrl} 
            alt={item.alt} 
            loading={index < 4 ? 'eager' : 'lazy'} 
          />
        )}
        {item.alt && <span class="gallery-title">{item.alt}</span>}
      </div>
    );
  })}
</div>

<!-- Lightbox Modal Dinámico -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" aria-label="Cerrar">&times;</button>
  <div class="lightbox-content" id="lightboxContent"></div>
</div>

<script>
  function initSlider(wrapper: HTMLElement) {
    const container = wrapper.querySelector<HTMLElement>('.slider-container');
    const cards = Array.from(wrapper.querySelectorAll<HTMLElement>('.slide-card'));
    const dots = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('.slider-dots .dot'));

    if (!container || cards.length === 0 || dots.length === 0) return;

    const AUTOPLAY_MS = 4000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Posición de scroll en la que cada tarjeta queda alineada al inicio
    function getTarget(index: number): number {
      const cRect = container!.getBoundingClientRect();
      const cardRect = cards[index].getBoundingClientRect();
      const padLeft = parseFloat(getComputedStyle(container!).paddingLeft) || 0;
      return cardRect.left - cRect.left + container!.scrollLeft - padLeft;
    }

    function getNearestIndex(): number {
      const maxScroll = container!.scrollWidth - container!.clientWidth;
      if (maxScroll > 0 && container!.scrollLeft >= maxScroll - 2) {
        return cards.length - 1;
      }
      let nearest = 0;
      let minDist = Infinity;
      for (let i = 0; i < cards.length; i++) {
        const dist = Math.abs(getTarget(i) - container!.scrollLeft);
        if (dist < minDist) {
          minDist = dist;
          nearest = i;
        }
      }
      return nearest;
    }

    function updateDots() {
      const current = getNearestIndex();
      dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
    }

    function goToSlide(index: number) {
      container!.scrollTo({ left: getTarget(index), behavior: 'smooth' });
    }

    // ---------- Autoplay ----------
    let timer: number | null = null;
    let hovering = false;
    let dragging = false;
    let inView = true;

    function canScroll(): boolean {
      return container!.scrollWidth - container!.clientWidth > 4;
    }

    function next() {
      if (!canScroll() || hovering || dragging || !inView || document.hidden) return;
      const current = getNearestIndex();
      // Al llegar a la última, vuelve a la primera
      goToSlide(current >= cards.length - 1 ? 0 : current + 1);
    }

    function stopAutoplay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(next, AUTOPLAY_MS);
    }

    // Solo avanza si el slider está visible en pantalla
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
      }, { threshold: 0.3 }).observe(wrapper);
    }

    wrapper.addEventListener('mouseenter', () => { hovering = true; });
    wrapper.addEventListener('mouseleave', () => { hovering = false; startAutoplay(); });

    // Táctil: pausa mientras hay un dedo encima
    container.addEventListener('touchstart', () => { dragging = true; stopAutoplay(); }, { passive: true });
    container.addEventListener('touchend', () => { dragging = false; startAutoplay(); }, { passive: true });
    container.addEventListener('touchcancel', () => { dragging = false; startAutoplay(); }, { passive: true });

    // ---------- Sincronizar puntos con el scroll ----------
    let ticking = false;
    container.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateDots();
        ticking = false;
      });
    }, { passive: true });

    // Clic en los puntos
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        startAutoplay(); // reinicia el temporizador
      });
    });

    // ---------- Arrastre con mouse ----------
    let isDown = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    container.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      isDown = true;
      moved = false;
      startX = e.clientX;
      startScroll = container.scrollLeft;
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        dragging = true;
        container.style.scrollSnapType = 'none';
        container.style.scrollBehavior = 'auto';
        container.style.cursor = 'grabbing';
      }
      if (moved) {
        container.scrollLeft = startScroll - dx;
      }
    });

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      dragging = false;
      if (!moved) return;
      const target = getTarget(getNearestIndex());
      container!.style.scrollSnapType = '';
      container!.style.scrollBehavior = '';
      container!.style.cursor = '';
      container!.scrollTo({ left: target, behavior: 'smooth' });
      startAutoplay();
    }

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    container.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    }, true);

    window.addEventListener('resize', updateDots);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) startAutoplay();
    });

    updateDots();
    startAutoplay();
  }

  document.querySelectorAll<HTMLElement>('.slider-wrapper').forEach(initSlider);
</script>

<style>
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  padding: 1rem 0;
}

.gallery-item {
  position: relative;
  border-radius: 0.75rem;
  overflow: hidden;
  cursor: pointer;
  aspect-ratio: 1;
  background: rgba(0, 0, 0, 0.05);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.gallery-item img,
.video-wrapper,
.video-wrapper video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.video-wrapper {
  position: relative;
}

.play-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.65);
  color: white;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  padding-left: 2px;
  backdrop-filter: blur(4px);
}

.gallery-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0.75rem 0.5rem 0.5rem;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
}

/* Lightbox Modal */
.lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  backdrop-filter: blur(4px);
}

.lightbox.open {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-content {
  width: 90%;
  max-width: 500px;
  display: flex;
  justify-content: center;
}

.lightbox-content img,
.lightbox-content video {
  max-width: 100%;
  max-height: 85vh;
  border-radius: 0.5rem;
  object-fit: contain;
}

.lightbox-close {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  background: none;
  border: none;
  color: white;
  font-size: 2.5rem;
  cursor: pointer;
  line-height: 1;
  z-index: 1001;
}

@media (min-width: 768px) {
  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
}
</style>