---
interface Props {
  slides: Array<{
    id: number | string;
    image: string;
    title: string;
    subtitle: string;
  }>;
}

const { slides } = Astro.props;
---

<div class="slider-wrapper">
  <div class="slider-container" id="sliderContainer">
    <div class="slider-track" id="sliderTrack">
      {slides.map((slide, index) => (
        <div class="slide-card">
          <img 
            src={slide.image} 
            alt={slide.title}
            class="slide-card__image"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="slide-card__body">
            <h3 class="slide-card__title">{slide.title}</h3>
            <p class="slide-card__text">{slide.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Puntos indicadores -->
  <div class="slider-dots" id="sliderDots">
    {slides.map((_, index) => (
      <button 
        class={`dot ${index === 0 ? 'active' : ''}`}
        data-index={index}
        aria-label={`Tarjeta ${index + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  const container = document.getElementById('sliderContainer');
  const track = document.getElementById('sliderTrack');
  const dots = document.querySelectorAll('.slider-dots .dot');

  if (container && track && dots.length > 0) {
    function getCardWidth() {
      const firstCard = track.querySelector('.slide-card');
      if (!firstCard) return 0;
      // Ancho de la tarjeta + el gap de 1rem (16px) definido en CSS
      return firstCard.getBoundingClientRect().width + 16;
    }

    function goToSlide(index: number) {
      const cardWidth = getCardWidth();
      container.scrollTo({
        left: cardWidth * index,
        behavior: 'smooth'
      });
    }

    // Sincronizar puntos según la posición del scroll en el contenedor principal
    container.addEventListener('scroll', () => {
      const cardWidth = getCardWidth();
      if (cardWidth === 0) return;
      
      const scrollPos = container.scrollLeft;
      const newIndex = Math.round(scrollPos / cardWidth);
      
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === newIndex);
      });
    }, { passive: true });

    // Clic en los puntos indicadores
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        goToSlide(index);
      });
    });
  }
</script>

<style>
.slider-wrapper {
  width: 100%;
  margin: 1rem 0 2rem;
}

.slider-container {
  width: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding: 0.5rem 1rem; /* Padding lateral dentro del scroll para que no corte las sombras */
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.slider-container::-webkit-scrollbar {
  display: none;
}

.slider-track {
  display: flex;
  gap: 1rem;
}

.slide-card {
  flex: 0 0 82%; /* Deja ver sutilmente la siguiente tarjeta */
  max-width: 300px;
  scroll-snap-align: start;
  border-radius: 1rem;
  overflow: hidden;
  background: var(--color-white, #FFF);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.slide-card__image {
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.slide-card__body {
  padding: 1rem;
}

.slide-card__title {
  font-size: 1rem;
  font-weight: 800;
  margin: 0 0 0.25rem;
  color: var(--color-black, #1A1A1A);
}

.slide-card__text {
  font-size: 0.8rem;
  color: var(--text-muted, #718096);
  margin: 0;
  line-height: 1.4;
}

/* Puntos indicadores */
.slider-dots {
  display: flex;
  justify-content: center;
  gap: 0.4rem;
  margin-top: 0.75rem;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.dot.active {
  width: 22px;
  border-radius: 4px;
  background: var(--color-red, #D62027);
}

/* Breakpoints adaptativos */
@media (min-width: 640px) {
  .slide-card {
    flex: 0 0 50%;
  }
  .slide-card__image {
    height: 170px;
  }
}

@media (min-width: 768px) {
  .slide-card {
    flex: 0 0 38%;
  }
  .slide-card__image {
    height: 190px;
  }
}
</style>