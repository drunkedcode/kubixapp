---
import { Utensils, Share2, Instagram, Facebook } from 'lucide-astro';
import FollowButton from '../shared/FollowButton.astro';

interface Props {
  slug: string;
  menuPath?: string;
  social?: {
    facebook?: string;
    instagram?: string;
    tiktok?: string;
  };
}

const { slug, menuPath = '#cardapio', social = {} } = Astro.props;
const menuHref = menuPath.startsWith('#') ? menuPath : `/restaurants/${slug}${menuPath}`;

const hasSocial = Boolean(social.instagram || social.facebook || social.tiktok);
---

<div class="fab">
  <!-- Arriba: seguir -->
  <FollowButton itemKey={`restaurants/${slug}`} />

  <!-- Medio: redes (se abren hacia la izquierda) -->
  {hasSocial && (
    <div class="fab__social">
      <button
        type="button"
        class="fab__sub"
        id="fab-social-toggle"
        aria-expanded="false"
        aria-controls="fab-social-list"
        aria-label="Redes sociales"
        title="Redes sociales"
      >
        <Share2 size={20} aria-hidden="true" />
      </button>

      <div class="fab__social-list" id="fab-social-list">
        {social.instagram && (
          <a href={social.instagram} class="fab__sub" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
            <Instagram size={20} aria-hidden="true" />
          </a>
        )}
        {social.facebook && (
          <a href={social.facebook} class="fab__sub" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
            <Facebook size={20} aria-hidden="true" />
          </a>
        )}
        {social.tiktok && (
          <a href={social.tiktok} class="fab__sub" target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a4.9 4.9 0 0 0-.88-.07 4.88 4.88 0 0 0 0 9.76 4.88 4.88 0 0 0 4.64-3.24l4.61 3.24v-3.78a6.12 6.12 0 0 1-1.41.15 6.5 6.5 0 0 1-1.8-.26v3.35a4.85 4.85 0 0 0 3 1.05 4.83 4.83 0 0 0 3.21-1.23 4.85 4.85 0 0 0 1.5-3.45V6.69h-3.45z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Abajo: cardápio -->
  <a href={menuHref} class="fab__main" aria-label="Ver Cardápio" title="Ver Cardápio">
    <Utensils size={26} strokeWidth={2.5} aria-hidden="true" />
  </a>
</div>

<script>
  const toggle = document.getElementById('fab-social-toggle');
  const list = document.getElementById('fab-social-list');

  if (toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (!list.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
/* Variables: --fab-* (definidas en global.css) */
.fab {
  position: fixed;
  bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
  /* Pegado al borde del marco de la app, no al de la ventana */
  right: max(1rem, calc((100vw - var(--app-max-width)) / 2 + 1rem));
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.75rem;
}

.fab__main {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 50%;
  background: var(--fab-main-bg);
  color: var(--fab-main-text);
  box-shadow: var(--fab-main-shadow);
  transition: transform 0.2s ease;
}
.fab__main:hover {
  transform: translateY(-3px);
}
.fab__main:active {
  transform: scale(0.94);
}

.fab__social {
  position: relative;
}

.fab__sub {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  padding: 0;
  border-radius: 50%;
  cursor: pointer;
  background: var(--fab-sub-bg);
  color: var(--fab-sub-text);
  border: 1.5px solid var(--fab-sub-border);
  box-shadow: var(--fab-sub-shadow);
  transition: transform 0.2s ease;
}
.fab__sub:active {
  transform: scale(0.94);
}

/* Redes: salen hacia la izquierda del botón */
.fab__social-list {
  position: absolute;
  top: 50%;
  right: calc(100% + 0.6rem);
  display: flex;
  gap: 0.5rem;
  opacity: 0;
  visibility: hidden;
  transform: translate(0.5rem, -50%);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
}
.fab__social-list.is-open {
  opacity: 1;
  visibility: visible;
  transform: translate(0, -50%);
}
</style>