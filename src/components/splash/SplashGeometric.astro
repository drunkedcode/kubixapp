---
import type { Restaurant } from '@/types';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;

// Tomamos una imagen del heroSlider o la del splash para mostrar el producto/plato estrella
const featuredImage = restaurant.heroSlider?.[0]?.image || restaurant.splash;
---
<div class="splash-theme splash-geometric" style={`--splash-bg: url(${restaurant.splash});`}>
  <div class="splash-overlay"></div>

  <!-- Elemento visual flotante del producto/plato estrella -->
  <div class="product-showcase">
    <img src={featuredImage} alt="Featured dish" />
  </div>

  <div class="splash-content-box">
    <div class="logo-container">
      <img src={restaurant.logo} alt={restaurant.name} />
    </div>
    <div class="text-group">
      <span class="welcome-badge">BEM-VINDO AO ESPAÇO</span>
      <h1>{restaurant.name}</h1>
      <p>{restaurant.tagline}</p>
    </div>
  </div>
</div>

<style>
.splash-geometric {
  position: fixed; inset: 0; z-index: 99999;
  background-image: var(--splash-bg); background-size: cover; background-position: center;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.splash-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(15,23,42,0.96) 30%, rgba(15,23,42,0.85) 100%);
  backdrop-filter: blur(8px);
}

/* Plato estrella entrando desde la derecha */
.product-showcase {
  position: absolute;
  top: 15%;
  right: -20px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid var(--brand-secondary, #FFD200);
  box-shadow: 0 15px 35px rgba(0,0,0,0.6);
  opacity: 0;
  animation: slide-in-right 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
}
.product-showcase img { width: 100%; height: 100%; object-fit: cover; }

/* Contenido principal */
.splash-content-box {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  gap: 1.2rem; padding: 0 1.5rem; width: 100%; max-width: 400px;
}

.logo-container {
  width: 90px; height: 90px; border-radius: 50%;
  background: white; border: 3px solid var(--brand-primary, #D62027);
  box-shadow: 0 8px 25px rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  opacity: 0;
  animation: drop-in-top 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
}
.logo-container img { width: 100%; height: 100%; object-fit: cover; }

.text-group {
  opacity: 0;
  animation: fade-up-content 0.8s ease 0.4s forwards;
}
.welcome-badge {
  display: inline-block; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.18em;
  color: var(--brand-secondary, #FFD200); background: rgba(255,210,0,0.12);
  padding: 0.3rem 0.8rem; border-radius: 20px; margin-bottom: 0.5rem;
  border: 1px solid rgba(255,210,0,0.3);
}
.text-group h1 { font-size: 2.2rem; font-weight: 950; color: white; margin: 0 0 0.3rem; }
.text-group p { font-size: 0.9rem; font-weight: 600; color: #cbd5e1; margin: 0; letter-spacing: 0.05em; }

/* Animaciones personalizadas */
@keyframes slide-in-right {
  0% { transform: translateX(80px) scale(0.8); opacity: 0; }
  100% { transform: translateX(0) scale(1); opacity: 0.9; }
}
@keyframes drop-in-top {
  0% { transform: translateY(-40px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes fade-up-content {
  0% { transform: translateY(25px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
</style>