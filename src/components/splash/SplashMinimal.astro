---
import type { SplashData } from '@/types';
interface Props { data: SplashData; }
const { data } = Astro.props;
---
<div class="splash-theme splash-minimal" style={`--splash-bg: url(${data.splash});`}>
  <div class="splash-overlay"></div>
  <div class="splash-glow"></div>

  <div class="minimal-wrapper-content">
    <div class="minimal-logo-frame">
      <img src={data.logo} alt={data.name} />
    </div>
    <div class="minimal-text-block">
      <span class="greeting-subtitle">BEM-VINDO AO NOSSO ESPAÇO</span>
      <h2>{data.name}</h2>
      <div class="accent-bar"></div>
      <p>{data.tagline}</p>
    </div>
  </div>
</div>

<style>
.splash-minimal {
  position: fixed; inset: 0; z-index: 99999;
  background-image: var(--splash-bg); background-size: cover; background-position: center;
  display: flex; align-items: center; justify-content: center;
}
.splash-overlay {
  position: absolute; inset: 0;
  background: color-mix(in srgb, var(--splash-overlay) 70%, transparent);
}
.splash-glow {
  position: absolute; inset: -20%;
  background: radial-gradient(circle at center, transparent 40%, color-mix(in srgb, var(--brand-primary) 25%, transparent) 100%);
  animation: breathe 4s ease-in-out infinite;
  pointer-events: none;
}

.minimal-wrapper-content {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  gap: 2rem; padding: 0 2rem;
}

.minimal-logo-frame {
  width: 110px; height: 110px; border-radius: 50%;
  border: 1px solid color-mix(in srgb, var(--brand-primary) 40%, transparent);
  padding: 6px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  animation: scale-up-fade 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards,
             ring-pulse 2.4s ease-in-out 1.1s infinite;
}
.minimal-logo-frame img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

.minimal-text-block { opacity: 0; animation: smooth-reveal 0.9s ease 0.3s forwards; }
.greeting-subtitle {
  display: block; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.25em;
  color: var(--brand-primary); margin-bottom: 0.7rem; text-transform: uppercase;
}
.minimal-text-block h2 { font-size: 2.5rem; font-weight: 300; color: white; margin: 0; letter-spacing: 0.04em; }
.accent-bar {
  width: 0; height: 2px; background: var(--brand-primary); margin: 0.8rem auto;
  animation: draw-bar 0.6s ease 0.8s forwards;
}
.minimal-text-block p { font-size: 0.85rem; font-weight: 400; color: #94a3b8; margin: 0; letter-spacing: 0.1em; }

@keyframes scale-up-fade { 0% { transform: scale(0.85); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
@keyframes smooth-reveal { 0% { transform: translateY(20px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
@keyframes draw-bar { to { width: 40px; } }
@keyframes ring-pulse {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand-primary) 35%, transparent); }
  50% { box-shadow: 0 0 0 10px transparent; }
}
@keyframes breathe { 0%, 100% { opacity: 0.5; transform: scale(1); } 50% { opacity: 0.9; transform: scale(1.08); } }
</style>