---
interface Props {
  slides: Array<{
    id: number | string;
    image: string;
    title: string;
    subtitle: string;
  }>;
}

const { slides } = Astro.props;
---

<div class="slider-wrapper">
  <div class="slider-container">
    <div class="slider-track">
      {slides.map((slide, index) => (
        <div class="slide-card">
          <img 
            src={slide.image} 
            alt={slide.title}
            class="slide-card__image"
            loading={index === 0 ? 'eager' : 'lazy'}
            draggable="false"
          />
          <div class="slide-card__body">
            <h3 class="slide-card__title">{slide.title}</h3>
            <p class="slide-card__text">{slide.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Puntos indicadores -->
  <div class="slider-dots">
    {slides.map((_, index) => (
      <button 
        type="button"
        class={`dot ${index === 0 ? 'active' : ''}`}
        data-index={index}
        aria-label={`Tarjeta ${index + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  function initSlider(wrapper: HTMLElement) {
    const container = wrapper.querySelector<HTMLElement>('.slider-container');
    const cards = Array.from(wrapper.querySelectorAll<HTMLElement>('.slide-card'));
    const dots = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('.slider-dots .dot'));

    if (!container || cards.length === 0 || dots.length === 0) return;

    // Posición de scroll en la que cada tarjeta queda alineada al inicio
    function getTarget(index: number): number {
      const cRect = container!.getBoundingClientRect();
      const cardRect = cards[index].getBoundingClientRect();
      const padLeft = parseFloat(getComputedStyle(container!).paddingLeft) || 0;
      return cardRect.left - cRect.left + container!.scrollLeft - padLeft;
    }

    function getNearestIndex(): number {
      const maxScroll = container!.scrollWidth - container!.clientWidth;
      // Al llegar al final, el último punto debe quedar activo
      if (maxScroll > 0 && container!.scrollLeft >= maxScroll - 2) {
        return cards.length - 1;
      }
      let nearest = 0;
      let minDist = Infinity;
      for (let i = 0; i < cards.length; i++) {
        const dist = Math.abs(getTarget(i) - container!.scrollLeft);
        if (dist < minDist) {
          minDist = dist;
          nearest = i;
        }
      }
      return nearest;
    }

    function updateDots() {
      const current = getNearestIndex();
      dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
    }

    function goToSlide(index: number) {
      container!.scrollTo({ left: getTarget(index), behavior: 'smooth' });
    }

    // Sincronizar puntos con el scroll
    let ticking = false;
    container.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateDots();
        ticking = false;
      });
    }, { passive: true });

    // Clic en los puntos
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goToSlide(i));
    });

    // Arrastre con mouse (en táctil el swipe ya es nativo)
    let isDown = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    container.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      isDown = true;
      moved = false;
      startX = e.clientX;
      startScroll = container.scrollLeft;
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        // Desactivar snap/smooth mientras se arrastra
        container.style.scrollSnapType = 'none';
        container.style.scrollBehavior = 'auto';
        container.style.cursor = 'grabbing';
      }
      if (moved) {
        container.scrollLeft = startScroll - dx;
      }
    });

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      if (!moved) return;
      const target = getTarget(getNearestIndex());
      container!.style.scrollSnapType = '';
      container!.style.scrollBehavior = '';
      container!.style.cursor = '';
      container!.scrollTo({ left: target, behavior: 'smooth' });
    }

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    // Evitar que un arrastre dispare clics en enlaces/elementos internos
    container.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    }, true);

    window.addEventListener('resize', updateDots);
    updateDots();
  }

  document.querySelectorAll<HTMLElement>('.slider-wrapper').forEach(initSlider);
</script>

<style>
.slider-wrapper {
  width: 100%;
  margin: 1rem 0 2rem;
}

.slider-container {
  width: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scroll-padding-inline: 1rem; /* Alinea el snap con el padding lateral */
  padding: 0.5rem 1rem; /* Padding lateral dentro del scroll para que no corte las sombras */
  scrollbar-width: none;
  -ms-overflow-style: none;
  cursor: grab;
}

.slider-container::-webkit-scrollbar {
  display: none;
}

.slider-track {
  display: flex;
  gap: 1rem;
}

.slide-card {
  flex: 0 0 82%; /* Deja ver sutilmente la siguiente tarjeta */
  max-width: 300px;
  scroll-snap-align: start;
  border-radius: 1rem;
  overflow: hidden;
  background: var(--color-white, #FFF);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.slide-card__image {
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.slide-card__body {
  padding: 1rem;
}

.slide-card__title {
  font-size: 1rem;
  font-weight: 800;
  margin: 0 0 0.25rem;
  color: var(--color-black, #1A1A1A);
}

.slide-card__text {
  font-size: 0.8rem;
  color: var(--text-muted, #718096);
  margin: 0;
  line-height: 1.4;
}

/* Puntos indicadores */
.slider-dots {
  display: flex;
  justify-content: center;
  gap: 0.4rem;
  margin-top: 0.75rem;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.dot.active {
  width: 22px;
  border-radius: 4px;
  background: var(--color-red, #D62027);
}

/* Breakpoints adaptativos */
@media (min-width: 640px) {
  .slide-card {
    flex: 0 0 50%;
  }
  .slide-card__image {
    height: 170px;
  }
}

@media (min-width: 768px) {
  .slide-card {
    flex: 0 0 38%;
  }
  .slide-card__image {
    height: 190px;
  }
}
</style>