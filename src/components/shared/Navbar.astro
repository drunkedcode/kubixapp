---
import { Clock, ChevronDown, X } from 'lucide-astro';

interface Props {
  name: string;
  tagline: string;
  logo: string;
  isOpen: boolean;
  todayHours: string;
  schedule: Array<{
    day: string;
    hours: string;
    current: boolean;
  }>;
  homeUrl?: string;
}

const {
  name,
  tagline,
  logo,
  isOpen,
  todayHours,
  schedule,
  homeUrl = "/"
} = Astro.props;
---

<header class="navbar">
  <div class="container navbar__inner">
    
    <!-- Marca -->
    <a href={homeUrl} class="navbar__brand" aria-label={`Página inicial de ${name}`}>
      <div class="navbar__logo-wrapper">
        <img 
          src={logo} 
          alt={name} 
          class="navbar__logo"
          width="44"
          height="44"
          loading="eager"
        />
      </div>
      <div class="navbar__info">
        <h1 class="navbar__name">{name}</h1>
        <p class="navbar__tag">{tagline}</p>
      </div>
    </a>

    <!-- Horarios -->
    <div class="navbar__schedule-wrapper">
      <button 
        id="schedule-toggle" 
        class="navbar__schedule-btn" 
        aria-expanded="false"
        aria-controls="schedule-dropdown"
      >
        <span class={`status-badge ${isOpen ? 'status-badge--open' : 'status-badge--closed'}`}>
          <span class="status-badge__dot"></span>
          {isOpen ? 'Aberto' : 'Fechado'}
        </span>
        <div class="navbar__hours-preview">
          <Clock size={12} />
          <span>{todayHours}</span>
          <ChevronDown size={14} class="navbar__chevron" />
        </div>
      </button>
      <div id="schedule-dropdown" class="schedule-dropdown" hidden>
        <div class="schedule-dropdown__header">
          <h3>Horário de Funcionamento</h3>
          <button id="schedule-close" class="schedule-dropdown__close" aria-label="Fechar">
            <X size={16} />
          </button>
        </div>
        <ul class="schedule-dropdown__list">
          {schedule.map((item) => (
            <li class={`schedule-dropdown__item ${item.current ? 'is-today' : ''}`}>
              <span class="schedule-dropdown__day">
                {item.day}
                {item.current && <span class="today-tag">Hoje</span>}
              </span>
              <span class="schedule-dropdown__hours">{item.hours}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('schedule-toggle');
  const closeBtn = document.getElementById('schedule-close');
  const dropdown = document.getElementById('schedule-dropdown');

  function openDropdown() {
    dropdown?.removeAttribute('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    toggleBtn?.classList.add('active');
  }

  function closeDropdown() {
    dropdown?.setAttribute('hidden', '');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.classList.remove('active');
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    isExpanded ? closeDropdown() : openDropdown();
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeDropdown();
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target) && !toggleBtn?.contains(e.target)) {
      closeDropdown();
    }
  });
</script>

<style>
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--navbar-primary, #FFD200);
  padding: 0.65rem 0;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  border-bottom: 2px solid var(--navbar-secondary, #E6BC00);
}
.navbar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}
.navbar__brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
}
.navbar__logo-wrapper {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
}
.navbar__logo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  background-color: var(--color-black, #1A1A1A);
  border: 2px solid var(--color-white, #FFFFFF);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}
.navbar__info {
  display: flex;
  flex-direction: column;
}
.navbar__name {
  font-size: 1.1rem;
  font-weight: 900;
  color: var(--color-black, #1A1A1A);
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.navbar__tag {
  font-size: 0.68rem;
  color: var(--accent, #D62027);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.navbar__schedule-wrapper {
  position: relative;
}
.navbar__schedule-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--navbar-secondary, #E6BC00);
  padding: 0.35rem 0.6rem;
  border-radius: 0.6rem;
  cursor: pointer;
  transition: all 0.2s ease;
}
.navbar__schedule-btn:hover,
.navbar__schedule-btn.active {
  background: var(--color-white, #FFFFFF);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  padding: 1px 6px;
  border-radius: 12px;
}
.status-badge--open {
  background-color: #dcfce7;
  color: #15803d;
}
.status-badge--closed {
  background-color: #fee2e2;
  color: var(--accent, #D62027);
}
.status-badge__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: currentColor;
}
.navbar__hours-preview {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--color-black, #1A1A1A);
}
.navbar__chevron {
  transition: transform 0.2s ease;
}
.navbar__schedule-btn.active .navbar__chevron {
  transform: rotate(180deg);
}
.schedule-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 260px;
  background: var(--color-white, #FFFFFF);
  border-radius: 0.75rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  border: 1px solid var(--border-light, #E5EAF0);
  padding: 0.85rem;
  z-index: 110;
  animation: fadeInDown 0.2s ease-out forwards;
}
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}
.schedule-dropdown__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-light, #E5EAF0);
  padding-bottom: 0.5rem;
  margin-bottom: 0.5rem;
}
.schedule-dropdown__header h3 {
  font-size: 0.8rem;
  color: var(--color-black, #1A1A1A);
  font-weight: 800;
}
.schedule-dropdown__close {
  background: none;
  border: none;
  color: var(--text-muted, #718096);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2px;
  border-radius: 4px;
}
.schedule-dropdown__close:hover {
  background: rgba(0, 0, 0, 0.05);
  color: var(--color-black, #1A1A1A);
}
.schedule-dropdown__list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.schedule-dropdown__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.75rem;
  color: var(--text-dark, #2D3748);
  padding: 0.25rem 0.4rem;
  border-radius: 0.35rem;
}
.schedule-dropdown__item.is-today {
  background-color: rgba(255, 210, 0, 0.1);
  font-weight: 700;
  color: var(--color-black, #1A1A1A);
  border-left: 3px solid var(--navbar-primary, #FFD200);
}
.today-tag {
  font-size: 0.6rem;
  background: var(--navbar-primary, #FFD200);
  color: var(--color-black, #1A1A1A);
  padding: 0 4px;
  border-radius: 3px;
  margin-left: 4px;
  font-weight: 800;
}
.schedule-dropdown__hours {
  font-size: 0.725rem;
  color: var(--text-muted, #718096);
}
.schedule-dropdown__item.is-today .schedule-dropdown__hours {
  color: var(--color-black, #1A1A1A);
}
</style>