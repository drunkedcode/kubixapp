---
// src/components/QRScanner.astro
---

<div class="qr-scanner-wrapper">
  <div id="reader" class="scanner-container"></div>
  <div id="scanner-result" class="scanner-result hidden"></div>
  
  <button id="start-camera-btn" class="scanner-btn">
     Escanear QR
  </button>
</div>

<script>
  import { Html5Qrcode } from "html5-qrcode";

  const startBtn = document.getElementById("start-camera-btn");
  const resultDiv = document.getElementById("scanner-result");
  let html5QrCode: Html5Qrcode | null = null;

  startBtn?.addEventListener("click", async () => {
    startBtn.style.display = "none";
    
    try {
      html5QrCode = new Html5Qrcode("reader");
      
      const qrCodeSuccessCallback = (decodedText: string) => {
        if (html5QrCode && html5QrCode.isScanning) {
          html5QrCode.stop().then(() => {
            if (resultDiv) {
              resultDiv.textContent = `Código leído: ${decodedText}`;
              resultDiv.classList.remove("hidden");
            }
            
            // Si el QR contiene una URL del menú o mesa, redirigimos automáticamente:
            if (decodedText.startsWith("http://") || decodedText.startsWith("https://") || decodedText.startsWith("/")) {
              window.location.href = decodedText;
            }
          }).catch(err => console.error("Error al apagar cámara:", err));
        }
      };

      const config = { fps: 10, qrbox: { width: 250, height: 250 } };

      // Inicia pidiendo la cámara trasera ('environment')
      await html5QrCode.start(
        { facingMode: "environment" },
        config,
        qrCodeSuccessCallback,
        () => {} // Callback silencioso para frames sin QR
      );
    } catch (err) {
      console.error("No se pudo iniciar la cámara:", err);
      alert("No se pudo acceder a la cámara. Verifica los permisos de tu navegador.");
      if (startBtn) startBtn.style.display = "inline-block";
    }
  });
</script>

<style>
  .qr-scanner-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    padding: 1rem;
  }

  .scanner-container {
    width: 100%;
    border-radius: 1rem;
    overflow: hidden;
    background: #0f172a;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .scanner-btn {
    padding: 0.8rem 1.5rem;
    background: linear-gradient(135deg, #d62027, #e8c85f);
    color: white;
    font-weight: 700;
    border: none;
    border-radius: 2rem;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(214, 32, 39, 0.3);
    transition: transform 0.2s ease;
  }

  .scanner-btn:active {
    transform: scale(0.98);
  }

  .scanner-result {
    padding: 0.8rem 1.2rem;
    background: #16a34a;
    color: white;
    font-weight: bold;
    border-radius: 0.5rem;
    text-align: center;
    width: 100%;
    word-break: break-all;
  }

  .hidden {
    display: none;
  }
</style>